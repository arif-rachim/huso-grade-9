# Huso: production settings. start.sh copies this to .env and fills in APP_KEY the first time.
APP_NAME="Huso"
APP_ENV=production
APP_DEBUG=false
# The address people type in the browser. For the family laptop: http://127.0.0.1:3000
# Behind a domain with HTTPS: https://huso.example.com
APP_URL=http://127.0.0.1:3000
# 127.0.0.1 = only this computer. Use 0.0.0.0 to open it to the home network or behind a proxy.
APP_HOST=127.0.0.1
APP_PORT=3000
APP_KEY=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta
DATABASE_URL=sqlite://storage/app.db
# Production marks cookies Secure: browsers send them over HTTPS only, except for
# 127.0.0.1/localhost. If you open the app by a LAN address over plain http (for example
# http://192.168.1.20:3000), login will not stick: use HTTPS (a proxy such as Caddy) or set APP_ENV=local.
